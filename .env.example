# ---- required -------------------------------------------------------------
BOT_TOKEN=123456789:AAExampleTokenFromBotFather
ADMIN_IDS=123456789            # your Telegram ID; comma-separate for several

# ---- web admin dashboard ---------------------------------------------------
# Browser dashboard at your host's URL (e.g. https://yourapp.onrender.com/).
# Set a real password here or the dashboard login is disabled.
DASHBOARD_PASSWORD=
# Optional: random string to sign session cookies. Falls back to BOT_TOKEN
# if unset — fine, but a dedicated secret is cleaner.
SESSION_SECRET=

# ---- storage --------------------------------------------------------------
# Leave DATABASE_URL empty to use a local SQLite file (fine on a VPS or PC).
# On Render/Koyeb/any host with an ephemeral disk you MUST set this to a
# Postgres URL (Supabase, Neon, ...) or your shop is wiped on every restart.
DATABASE_URL=

# ---- cosmetics ------------------------------------------------------------
SHOP_NAME=Digital Shop
CURRENCY=USDT
